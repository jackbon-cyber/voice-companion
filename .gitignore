# ===== 编译产物 =====
target/
build/
dist/
out/
*.class
*.jar
*.war
*.pyd
*.so
*.dylib
*.dll

# ===== 依赖目录 =====
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/

# ===== 模型权重（体积大，走脚本按需下载，不入库）=====
models/
core/models/
*.gguf
*.bin
*.onnx
*.pt
*.safetensors
*.tflite
whisper/
*.wav
*.pcm

# ===== 本地密钥与配置 =====
.env
.env.local
*.local
local.properties
application-local.yml
application-local.yaml

# ===== 日志与运行时产物 =====
logs/
*.log
data/chroma/
chroma_data/
eval/reports/*.json

# ===== 评测运行产物（评测集本身是源文件，必须入库）=====
# 报告由 core/scripts/eval.ps1 每次运行重新生成，是"当次实测"的快照而非源文件。
# 入库会让人误以为它是"某次提交的权威指标"，随代码演进即失真。
core/eval-report.md
core/eval-report.json
core/eval-edge-report.md
core/eval/*.out
core/eval/*.out.log
core/eval/*.err.log

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== deploy 层：公司内网适配，私有实现，不进开源仓库 =====
deploy/*
!deploy/README.md
!deploy/.gitkeep
