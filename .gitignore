# ===== 编译产物 =====
target/
build/
dist/
out/
*.class
*.jar
*.war
*.pyd
*.so
*.dylib
*.dll

# ===== 依赖目录 =====
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/

# ===== 模型权重（体积大，走脚本按需下载，不入库）=====
models/
core/models/
*.gguf
*.bin
*.onnx
*.pt
*.safetensors
*.tflite
whisper/
*.wav
*.pcm

# ===== 本地密钥与配置 =====
.env
.env.local
*.local
local.properties
application-local.yml
application-local.yaml

# ===== 日志与运行时产物 =====
logs/
*.log
data/chroma/
chroma_data/
eval/reports/*.json

# 端到端与评测的运行产物：每次运行重新生成，是"当次实测"的快照而非源文件。
# 入库会让人误以为它是"某次提交的权威结果"，随代码演进即失真。
data/reports/
data/*.log
data/*.json
!data/.gitkeep

# ===== 评测运行产物（评测集本身是源文件，必须入库）=====
# 报告由 core/scripts/eval.ps1 每次运行重新生成，是"当次实测"的快照而非源文件。
# 入库会让人误以为它是"某次提交的权威指标"，随代码演进即失真。
core/eval-report.md
core/eval-report.json
core/eval-edge-report.md
core/eval/*.out
core/eval/*.out.log
core/eval/*.err.log

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 架构方案文档的打包件（可由 tools/ 重新生成，不入库）=====
# 方案文档的 markdown 合并产物与 docx 都是**生成文件**，
# 由 docs/architecture/parts/*.md 经 tools/build_companion_doc.py 产出。
# 源文件入库、生成物不入库 —— 避免"生成物被当成权威版本"的误读。
docs/architecture/*.docx
docs/architecture/语音情感陪伴机器人.zip

# ===== deploy 层：公司内网适配，私有实现，不进开源仓库 =====
deploy/*
!deploy/README.md
!deploy/.gitkeep
