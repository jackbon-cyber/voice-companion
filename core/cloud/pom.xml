<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.company.bj.voice</groupId>
    <artifactId>voice-cloud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>voice-cloud</name>
    <description>语音情感陪伴机器人云端服务</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <json-schema-validator.version>1.5.6</json-schema-validator.version>
        <agentscope.version>2.0.4</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM 必须先导入，保证 Jackson/JUnit 版本生效 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          JSON Schema 校验器。Java 侧与 Python 侧读同一份 schema 文件，
          版本显式锁定，避免随 Spring Boot BOM 漂移导致两侧校验口径不一致。
        -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!--
          AgentScope 核心契约。本工程只用它的消息模型（Msg）与记忆契约（LongTermMemory），
          把多智能体编排的接口形态与上游对齐；不引入它的模型扩展（dashscope / openai /
          ollama），那些在本工程的原型分类路线下用不上，且会拖慢离线构建。
          版本显式锁定，与 design.md 的 D3 一致。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              协议 schema 进 jar。

              ★ 为什么必须显式声明默认 resources：
              Maven 的默认 resources 目录是 src/main/resources，而协议 schema
              实际住在 core/protocol/schema/ —— **不在** cloud 模块里。
              于是打出来的 fat jar 里没有 schema，部署后每条上行消息都会被判
              "未知协议 schema"而丢弃。

              而这个缺陷**不会报错**：云端只是退回降级话术继续对话，
              看起来"能用"，实则协议校验完全失效。
              实测记录见 docs/operations-manual.md 第 4 章。
            -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- 协议 schema 打进 jar 的 protocol/schema/ 下 -->
                <directory>${project.basedir}/../protocol/schema</directory>
                <targetPath>protocol/schema</targetPath>
                <includes>
                    <include>*.schema.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              固定 surefire 的 fork 行为：本机 Windows 上默认的 forkCount 偶发出现
              "The forked VM terminated without properly saying goodbye"，
              原因是 boot manifest-jar 里的 classpath 含绝对路径且跨盘符根目录，
              fork 出来的 JVM 启动即失败。关掉 fork 复用与设置单一 fork 即可稳定复现测试。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
