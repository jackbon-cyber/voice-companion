{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-companion/protocol/session.schema.json",
  "title": "会话生命周期消息",
  "description": "会话的开始、进行中与结束三态消息，以及心跳。",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "type"],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["begin", "keepalive", "end"],
      "description": "会话状态。"
    },
    "reason": {
      "type": "string",
      "description": "结束原因。type=end 时必填。"
    },
    "ownerKey": {
      "type": "string",
      "minLength": 1,
      "description": "会话归属的用户标识。云端据此绑定记忆作用域 —— 没有它，云端写的记忆全部落进同一个作用域，跨用户隔离无从谈起。生产部署中该值应由接入凭据推导，而非由设备自报。"
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0
    },
    "audioFormat": {
      "$ref": "audio-negotiation.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "end" } },
        "required": ["type"]
      },
      "then": {
        "required": ["reason"]
      }
    }
  ]
}
